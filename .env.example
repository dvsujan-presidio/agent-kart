# --- Model: OpenAI models in Microsoft Foundry (see docs/azure-setup.md) ---
FOUNDRY_RESOURCE=your-foundry-resource
MODEL_ENDPOINT=https://your-foundry-resource.cognitiveservices.azure.com/   # Foundry portal > Keys and Endpoint
MODEL_API_VERSION=2024-12-01-preview
MODEL_API_KEY=
MODEL_DEPLOYMENT=gpt-5.6-luna
MODEL_DEPLOYMENT_FAST=gpt-5.6-luna

# --- Approval gate ---
APPROVAL_HMAC_SECRET=change-me-locally   # Key Vault in Azure
APPROVAL_TTL_SECONDS=90

# --- Voice (LiveKit Cloud + Azure AI Speech) ---
VOICE_MODE=true
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
STT_LANGUAGES=en-IN
TTS_VOICE=en-IN-NeerjaNeural
AGENTKART_API_URL=http://localhost:8000

# --- App ---
DB_BACKEND=sqlite
DEFAULT_TIMEZONE=Asia/Kolkata
DEMO_MODE=true

# --- Real Store Mode (USD, never pays) ---
REAL_STORE_MODE=true
REAL_STORE_SEARCH=true
REAL_STORE_CART=true
REAL_STORE_HANDOFF=true
REAL_STORE_REPLAY=false
REAL_STORE_RECORD=false
# Public URL of the AgentKart UCP agent profile (stores fetch it on every call). Leave empty to use the
# quick tunnel URL written by scripts/start_profile.sh to .run/profile_url.
AGENT_PROFILE_URL=
REAL_STORE_SCENARIOS=camping_weekend,first_apartment,home_gym,birthday_party

# --- Big-retailer price check (off by default) ---
PRICE_CHECK=false

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
