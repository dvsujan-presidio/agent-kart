{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "budgetContactEmail": {
      "value": "${BUDGET_CONTACT_EMAIL}"
    },
    "foundryLocation": {
      "value": "${FOUNDRY_LOCATION=eastus}"
    },
    "location": {
      "value": "${AZURE_LOCATION=centralindia}"
    }
  }
}